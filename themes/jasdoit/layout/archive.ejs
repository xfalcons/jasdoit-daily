<section class="reading-library archive-page"><div class="section-heading"><div><p class="eyebrow">THE READING ROOM</p><h1><%= page.category || page.tag || '閱讀筆記' %></h1></div></div><% page.posts.each(function(post) { %><article class="lesson-row"><time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY.MM.DD') %></time><h2><a href="<%= url_for(post.path) %>"><%= post.reading_title || post.title %></a></h2></article><% }); %><% if (page.total > 1) { %><nav class="pagination" aria-label="文章分頁"><%- paginator({prev_text:'上一頁',next_text:'下一頁'}) %></nav><% } %></section>
